# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Settings
# For PostgreSQL (Docker): postgres://<user>:<password>@db:5432/<database>
# For PostgreSQL (Local):  postgres://<user>:<password>@localhost:5432/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db

# Email Settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# PayPal Settings
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET_KEY=your-paypal-secret-key

# API Settings
PSGC_API_BASE_URL=https://psgc.gitlab.io/api

# Google OAuth Settings
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret